mixin picture({ name, alt = '', width, height, sizes = '(min-width: 768px) 50vw, 100vw', className = '', lazy = true, fetchpriority = null })
  - const base = `/src/assets/images/${name}`;
  picture
    source(type='image/avif', srcset=`${base}-400.avif 400w, ${base}-800.avif 800w`, sizes=sizes)
    source(type='image/webp', srcset=`${base}-400.webp 400w, ${base}-800.webp 800w`, sizes=sizes)
    img(
      class=className || null,
      src=`${base}-800.jpg`,
      alt=alt,
      width=width,
      height=height,
      loading=lazy ? 'lazy' : null,
      fetchpriority=!lazy ? fetchpriority || 'high' : null,
      decoding='async'
    )
