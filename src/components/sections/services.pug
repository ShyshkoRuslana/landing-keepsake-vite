section#about.section.services(aria-labelledby="services-title")
    .container
        h2#services-title.section-title What do we do
        p.lead We are a small team of designers and makers who help brands look their best online and offline.
        ul.services__list
            each service in services
                li.service
                    span.service__icon(class={'service__icon--heart': service.icon === 'heart'})
                        +icon(service.icon)
                    h3.service__title #{service.title}
                    p #{service.description}