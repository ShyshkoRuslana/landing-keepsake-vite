footer#contact.site-footer
  .container
    .footer__top
      .footer__links
        each col in footerNavs
          nav(aria-labelledby=col.id)
            h2.footer__title(id=col.id) #{ col.title }
            ul
              each link in col.links
                li
                  a(href=link.href) #{ link.label }

      .newsletter
        h2.footer__title Newsletter
        p.newsletter__text Fresh case studies and design notes, once a month.
        form#subscribe-form.newsletter__form(action='#subscribed')
          .newsletter__row
            .field
              label.sr-only(for='email') Your email address
              input#email(
                name='email',
                type='email',
                placeholder='Your email address',
                required,
                aria-describedby='email-error'
              )
              p#email-error.error Please enter a valid email address.
            +btn('Subscribe', null, 'primary')(type='submit')
          label.consent
            input(type='checkbox', name='consent', required)
            |
            | I agree to the privacy policy
        p#subscribed.success(role='status') You’re in! Check your inbox to confirm.

    .footer__bottom
      ul.socials
        each soc in socials
          li
            a.social(style=`--c:${soc.color}`, href=soc.href, aria-label=soc.label)
              +icon(soc.icon)
      p.copyright © 2026 Keepsake. All rights reserved.
